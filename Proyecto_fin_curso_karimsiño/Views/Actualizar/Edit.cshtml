@model Proyecto_fin_curso_karimsiño.Models.RegisterModel

@{
    ViewData["Title"] = "Actualizar Credencial";
}

<div class="container-fluid px-4 py-4">

    <!-- Breadcrumb / Volver -->
    <div class="mb-4">
        <a asp-controller="Listado" asp-action="ListaRegistro"
               class="d-inline-flex align-items-center gap-1 text-muted text-decoration-none back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                 class="bi bi-arrow-left" viewBox="0 0 16 16">
                <path fill-rule="evenodd"
                      d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
            </svg>
            Volver al listado
        </a>
    </div>

    <!-- Card principal -->
    <div class="edit-card mx-auto">

        <!-- Header de la card -->
        <div class="edit-card-header">
            <div class="portal-card-icon icon-purple mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor"
                     class="bi bi-pencil-square" viewBox="0 0 16 16">
                    <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                    <path fill-rule="evenodd"
                          d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                </svg>
            </div>
            <h5 class="fw-bold mb-1" style="color:#1e293b;">Actualizar Credencial</h5>
            <p class="text-muted mb-0" style="font-size:0.875rem;">
                Modifica la contraseña y/o el rol del colaborador.
            </p>
        </div>

        <!-- Info del colaborador (solo lectura) -->
        <div class="colaborador-info">
            <div class="avatar-circle-lg">
                @Model.nombre.Substring(0, 1).ToUpper()
            </div>
            <div>
                <div class="fw-semibold" style="color:#1e293b;">@Model.nombre</div>
                <div class="text-muted" style="font-size:0.82rem;">@Model.correo</div>
            </div>
        </div>

        <!-- Formulario -->
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"
                 style="font-size:0.85rem; border-radius:10px; display:none;"></div>

            <!-- Campo oculto para Id y datos de solo lectura -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="nombre" />
            <input type="hidden" asp-for="correo" />

            <!-- Rol -->
            <div class="form-group-portal mb-3">
                <label asp-for="rol" class="portal-label">Cargo / Rol</label>
                <input asp-for="rol" class="portal-input" placeholder="Ej: Desarrollador, Analista..." />
                <span asp-validation-for="rol" class="text-danger" style="font-size:0.8rem;"></span>
            </div>

            <!-- Contraseña -->
            <div class="form-group-portal mb-1">
                <label asp-for="clave" class="portal-label">Contraseña</label>
                <div class="input-with-btn">
                    <input asp-for="clave" class="portal-input" id="claveInput"
                           placeholder="Nueva contraseña..." />
                    <button type="button" class="btn-generar" onclick="generarClave()"
                            title="Generar contraseña aleatoria">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                             fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                            <path fill-rule="evenodd"
                                  d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
                        </svg>
                        Generar
                    </button>
                </div>
                <span asp-validation-for="clave" class="text-danger" style="font-size:0.8rem;"></span>
            </div>

            <!-- Botones de acción -->
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn portal-btn btn-indigo flex-grow-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                         fill="currentColor" class="bi bi-check-lg me-1" viewBox="0 0 16 16">
                        <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425z" />
                    </svg>
                    Guardar cambios
                </button>
                <a asp-controller="Listado" asp-action="ListaRegistro"
                       class="btn portal-btn btn-slate">
                    Cancelar
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @Html.Raw(@"<script>
        function generarClave() {
            const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*';
            let password = '';
            for (let i = 0; i < 12; i++) {
                password += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('claveInput').value = password;
        }
    </script>")
}
