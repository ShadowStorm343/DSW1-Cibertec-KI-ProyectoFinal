@{
    ViewData["Title"] = "Bienvenido";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm portal-alert" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
        </svg>
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Header -->
<div class="portal-hero text-center">
    <h1 class="portal-title">Bienvenido al Portal de Credenciales</h1>
    <p class="portal-subtitle">
        Sistema centralizado para la gestión y administración de credenciales de empleados. Accede a
        las funcionalidades principales desde el panel de control.
    </p>
</div>

<!-- Cards Grid -->
<div class="container-fluid px-4">
    <div class="row g-4 mb-4">

        <div class="col-12 col-md-6 col-lg-4">
            <div class="portal-card">
                <div class="portal-card-icon icon-blue">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-person-plus" viewBox="0 0 16 16">
                        <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H1s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C9.516 10.68 8.289 10 6 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z" />
                        <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5" />
                    </svg>
                </div>
                <h5 class="portal-card-title">Registrar Empleado</h5>
                <p class="portal-card-desc">Añade nuevos empleados al sistema y genera sus credenciales de acceso.</p>
                <a class="btn portal-btn btn-blue w-100" asp-area="" asp-controller="Register" asp-action="Create">
                    Nuevo Registro
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="portal-card">
                <div class="portal-card-icon icon-teal">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.099zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                </div>
                <h5 class="portal-card-title">Consultar Credenciales</h5>
                <p class="portal-card-desc">Busca y visualiza información de credenciales existentes en la base de datos.</p>
                <a class="btn portal-btn btn-teal w-100" asp-area="" asp-controller="Listado" asp-action="ListaRegistro">
                    Buscar
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="portal-card">
                <div class="portal-card-icon icon-purple">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                    </svg>
                </div>
                <h5 class="portal-card-title">Actualizar Datos</h5>
                <p class="portal-card-desc">Modifica información de empleados y actualiza credenciales cuando sea necesario.</p>
                <a class="btn portal-btn btn-indigo w-100" asp-area="" asp-controller="Actualizar" asp-action="Edit">
                    Actualizar
                </a>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="portal-card">
                <div class="portal-card-icon icon-violet">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-bar-chart-line" viewBox="0 0 16 16">
                        <path d="M11 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h1V7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7h1zm1 12h2V2h-2zm-3 0V7H7v7zm-5 0v-3H2v3z" />
                    </svg>
                </div>
                <h5 class="portal-card-title">Reportes</h5>
                <p class="portal-card-desc">Genera reportes y estadísticas sobre las credenciales emitidas.</p>
                <a class="btn portal-btn btn-violet w-100" asp-area="" asp-controller="Reportes" asp-action="Index">
                    Ver Reportes
                </a>
            </div>
        </div>
    </div>
</div>

