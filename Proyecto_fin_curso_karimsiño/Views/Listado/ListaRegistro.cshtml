@model IEnumerable<Proyecto_fin_curso_karimsiño.Models.RegisterModel>

@{
    ViewData["Title"] = "Colaboradores Registrados";
    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
    int totalRegistros = ViewBag.TotalRegistros;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0" style="color:#1e293b;">Lista de Colaboradores</h4>
            <small class="text-muted">@totalRegistros colaborador(es) registrado(s) en total</small>
        </div>
        <a asp-controller="Register" asp-action="Create" class="btn portal-btn btn-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                 class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
                <path fill-rule="evenodd"
                      d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" />
            </svg>
            Nuevo Colaborador
        </a>
    </div>

    <div class="table-card">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table lista-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol / Cargo</th>
                            <th>Contraseña</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">@item.Id</td>
                                <td>
                                    <span class="fw-semibold">@item.nombre</span>
                                </td>
                                <td class="text-muted">@item.correo</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.rol))
                                    {
                                        <span class="badge-rol">@item.rol</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Sin rol</span>
                                    }
                                </td>
                                <td>
                                    <code class="clave-code">@item.clave</code>
                                </td>
                                <td>
                                    <a asp-controller="Actualizar"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn-accion btn-accion-editar"
                                           title="Editar credencial">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                             fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z" />
                                        </svg>
                                        Editar
                                    </a>
                                    <form asp-controller="Listado"
                                          asp-action="Eliminar"
                                          asp-route-id="@item.Id"
                                          asp-route-pagina="@paginaActual"
                                          method="post"
                                          style="display:inline;"
                                          onsubmit="return confirm('¿Seguro que deseas eliminar a @item.nombre?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn-accion btn-accion-eliminar"
                                                title="Eliminar colaborador">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                 fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                            </svg>
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#cbd5e1"
                     class="bi bi-people mb-3 d-block mx-auto" viewBox="0 0 16 16">
                    <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.deputados 1-3 4-3q.474 0 .92.086M12 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
                </svg>
                <p class="mb-0 fw-semibold">No hay colaboradores registrados.</p>
                <small>Haz clic en "Nuevo Colaborador" para agregar el primero.</small>
            </div>
        }
    </div>

    @if (totalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
            <small class="text-muted">
                Página <strong>@paginaActual</strong> de <strong>@totalPaginas</strong>
            </small>
            <nav aria-label="Paginación">
                <ul class="pagination-portal mb-0">
                    <li class="@(paginaActual == 1 ? "disabled" : "")">
                        <a asp-action="ListaRegistro" asp-route-pagina="@(paginaActual - 1)"
                               class="page-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                 fill="currentColor" class="bi bi-chevron-left" viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                      d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
                            </svg>
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li>
                            <a asp-action="ListaRegistro" asp-route-pagina="@i"
                               class="page-btn @(i == paginaActual ? "active" : "")">@i</a>
                        </li>
                    }
                    <li class="@(paginaActual == totalPaginas ? "disabled" : "")">
                        <a asp-action="ListaRegistro" asp-route-pagina="@(paginaActual + 1)"
                               class="page-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                 fill="currentColor" class="bi bi-chevron-right" viewBox="0 0 16 16">
                                <path fill-rule="evenodd"
                                      d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
